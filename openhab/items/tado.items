// tado letto in locale via HomeKit (binding homekit), senza cloud.
// ECCEZIONE al "tutto in git": i Thing sono stati creati dalla Inbox della UI e
// stanno nel jsondb di openHAB (compreso nel backup), non in things/:
//   bridge     homekit:bridge:9a7bc8b8506a              "tado Internet Bridge" (.8)
//   termostato homekit:bridged-accessory:9a7bc8b8506a:2 "Tado Termostato Sala"
//   testina    homekit:bridged-accessory:9a7bc8b8506a:3 "Tado Veranda" (dal 12/10/2026)
//   testine aggiunte il 27/10/2026 (nel bridge hanno solo il numero di serie):
//     :4 VA1142240000 Camera, :5 VA3216971008 Camera di Luca,
//     :6 VA3004576512 Bagno,  :7 VA2803249920 Sala
// La temperatura di ogni stanza, Sala compresa, e' quella della testina; il
// termostato a muro (:2) accende la caldaia quando almeno una zona chiede calore.
// Le chiavi di abbinamento stanno in HomekitKeyStore (jsondb).
// I numeri in coda ai canali (-12, -13...) sono gli identificativi HomeKit delle
// caratteristiche: se il bridge viene riabbinato o sostituito vanno ricontrollati.
//
// Per ora solo lettura: temperatura impostata e modo hanno readOnly, cosi' dalla
// UI non si cambia il termostato per sbaglio. Si comanda dall'app tado.
// Valori HomeKit: riscaldamento ora 0=spento 1=riscalda 2=raffredda; modo
// 0=off 1=heat 2=cool 3=auto. Le etichette in italiano vengono da "options".
// Sono stringhe: rrd4j non le storicizza; lo storico delle richieste di calore
// c'e' gia' in Caldaia_RichiestaTado (ingresso dello Shelly caldaia).

Group gTado "tado"

Number:Temperature   Tado_Sala_Temperatura   "Termostato a muro - temperatura (tado) [%.1f °C]"           <temperature> (gTado, gStorico) { channel="homekit:bridged-accessory:9a7bc8b8506a:2:thermostat#temperature-current-14", unit="°C" }
Number:Temperature   Tado_Sala_Impostata     "Termostato a muro - temperatura impostata (tado) [%.1f °C]" <heating>     (gTado, gStorico) { channel="homekit:bridged-accessory:9a7bc8b8506a:2:thermostat#temperature-target-15", unit="°C", stateDescription=""[pattern="%.1f °C", readOnly=true] }
Number:Dimensionless Tado_Sala_Umidita       "Termostato a muro - umidità (tado) [%.0f %%]"               <humidity>    (gTado, gStorico) { channel="homekit:bridged-accessory:9a7bc8b8506a:2:thermostat#relative-humidity-current-17", unit="%" }
String               Tado_Sala_Riscaldamento "Termostato a muro - chiamata caldaia (tado) [%s]"          <fire>        (gTado)           { channel="homekit:bridged-accessory:9a7bc8b8506a:2:thermostat#heating-cooling-current-12", stateDescription=""[options="0=Spento,1=Riscalda,2=Raffredda", readOnly=true] }
String               Tado_Sala_Modo          "Termostato a muro - modo (tado) [%s]"                       <heating>     (gTado)           { channel="homekit:bridged-accessory:9a7bc8b8506a:2:thermostat#heating-cooling-target-13", stateDescription=""[options="0=Spento,1=Riscaldamento,2=Raffrescamento,3=Automatico", readOnly=true] }

// --- Veranda (testina sul termosifone, montata il 12/10/2026) -----------------
Number:Temperature   Tado_Veranda_Temperatura   "Veranda - temperatura (tado) [%.1f °C]"           <temperature> (gTado, gStorico, gGrafTemperatureCasa) { channel="homekit:bridged-accessory:9a7bc8b8506a:3:thermostat#temperature-current-14", unit="°C" }
Number:Temperature   Tado_Veranda_Impostata     "Veranda - temperatura impostata (tado) [%.1f °C]" <heating>     (gTado, gStorico) { channel="homekit:bridged-accessory:9a7bc8b8506a:3:thermostat#temperature-target-15", unit="°C", stateDescription=""[pattern="%.1f °C", readOnly=true] }
Number:Dimensionless Tado_Veranda_Umidita       "Veranda - umidità (tado) [%.0f %%]"               <humidity>    (gTado, gStorico, gGrafUmiditaCasa) { channel="homekit:bridged-accessory:9a7bc8b8506a:3:thermostat#relative-humidity-current-17", unit="%" }
String               Tado_Veranda_Riscaldamento "Veranda - riscaldamento ora (tado) [%s]"          <fire>        (gTado)           { channel="homekit:bridged-accessory:9a7bc8b8506a:3:thermostat#heating-cooling-current-12", stateDescription=""[options="0=Spento,1=Riscalda,2=Raffredda", readOnly=true] }
String               Tado_Veranda_Modo          "Veranda - modo (tado) [%s]"                       <heating>     (gTado)           { channel="homekit:bridged-accessory:9a7bc8b8506a:3:thermostat#heating-cooling-target-13", stateDescription=""[options="0=Spento,1=Riscaldamento,2=Raffrescamento,3=Automatico", readOnly=true] }

